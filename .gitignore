# Signing credentials — must never be committed, whatever platform
*.p8
*.p12
*.mobileprovision
*.jks
*.keystore
*.certSigningRequest
ios-signing/
android-signing/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Capacitor — generated native projects (ios/, android/ themselves are committed;
# these are per-machine build artifacts and local overrides within them)
ios/App/Pods
ios/App/build
ios/App/App.xcworkspace/xcuserdata
ios/App/App.xcodeproj/xcuserdata
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata
*.xcuserstate

android/app/build
android/build
android/.gradle
android/local.properties
android/.idea
android/captures
android/app/release

# Capgo OTA signing key — never commit; treat like any other private signing key
.capgo_key_v2
.capgo_key_v2.pub
capgo_key_v2
